rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Café seed data from OpenStreetMap: anyone can read, only the
    // upload script (Admin SDK, which bypasses rules) can write.
    match /cafes/{cafeId} {
      allow read: if true;
      allow write: if false;
    }

    // Profiles: any signed-in user can read them; only the owner can write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // Email, settings and push tokens stay private to the owner.
      match /private/{document} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else stays locked until its feature is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
