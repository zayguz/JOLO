{
  "expo": {
    "scheme": "joloapp",
    "experiments": {
      "typedRoutes": true
    },
    "name": "JOLO_app",
    "slug": "JOLO_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zayguz.jolo"
    },
    "android": {
      "package": "com.zayguz.jolo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JOLO uses your location to show cafés near you and how far away they are."
        }
      ]
    ]
  }
}
